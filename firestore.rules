rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    match /rooms/{roomCode} {
      // Clients read a room by its exact code. Collection enumeration is denied:
      // `allow read` would grant `list`, letting anyone download every live room
      // and every player id in it (Issue 96). The app only ever does document gets.
      allow get: if true;
      allow list: if false;
      
      // All writes to rooms must be done via Admin SDK (Cloud Functions)
      allow write: if false;

      match /players/{playerId} {
        // Anyone can read the player list
        allow read: if true;
        
        // Creation is handled by createRoom and joinRoom callables
        allow create: if false;
        
        // Players can update only cosmetic/heartbeat fields on their own document.
        // Note: lastReaction and lastReactionAt are intentionally retained dead fields from the removed reaction feature (Issue 74, August 2026), kept to avoid a rules deploy and data migration. Safe to drop when firestore.rules is next revised.
        // Critical game fields like score, role, host status, and rejoin identifiers are locked to server writes.
        allow update: if isAuthenticated() 
                      && resource.data.authUid == request.auth.uid
                      && !request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['role', 'totalScore', 'timesFooled', 'playersDeceived', 'isHost', 'joinedAt', 'hasRerolled', 'authUid', 'id', 'expiresAt']);
        
        // Deletions and host handoffs are handled server-side by handleDisconnect callable
        allow delete: if false;
      }
    }
  }
}
